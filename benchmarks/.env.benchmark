DATABASE_URL=postgresql://roomfinder:roomfinder-local-only@127.0.0.1:55432/roomfinder_benchmark?schema=public
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=benchmark-only-access-secret-change-me
JWT_REFRESH_SECRET=benchmark-only-refresh-secret-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OPENROUTER_API_KEY=
EMAIL_PROVIDER=smtp
EMAIL_FROM=benchmarks@hello-roommate.local
SMTP_HOST=127.0.0.1
SMTP_PORT=58025
PORT=5501
NODE_ENV=test
LOG_LEVEL=warn
CORS_ORIGIN=http://127.0.0.1:5173
# Benchmark-only controls; production defaults remain 10s / 60s / 10 rows.
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_RETRY_BASE_MS=500
OUTBOX_BATCH_SIZE=50
# Performance runs raise the limiter without bypassing authentication or RBAC.
API_RATE_LIMIT_MAX=1000000
AUTH_RATE_LIMIT_MAX=1000000
