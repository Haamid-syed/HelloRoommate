{
  "name": "roomfinder",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "predev": "npm run build -w shared",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "build:backend": "npm run db:generate && npm run build -w shared && npm run build -w server",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:generate": "npm run db:generate -w server",
    "benchmark:seed": "tsx benchmarks/seed.ts",
    "benchmark:http": "tsx benchmarks/http.ts",
    "benchmark:db": "tsx benchmarks/database.ts",
    "benchmark:verify": "tsx benchmarks/verify-invariants.ts",
    "benchmark:outbox": "tsx benchmarks/outbox-recovery.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
